# vmon guest kernel: arm64-only options (on top of common.config).
# Boot path under HVF/KVM: PSCI firmware, GICv3, PL011 + 8250 MMIO console
# (`earlycon=uart8250,mmio,0x9000000`), device tree from the VMM.
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
