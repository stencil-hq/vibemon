# vmon guest kernel: x86_64-only options (on top of common.config).
# Boot path under KVM: PVH/bzImage entry, kvm-clock, 8250 console on ttyS0.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
CONFIG_PVH=y
# 32-bit userspace (multilib toolchains, old binaries); E2B guests have it.
CONFIG_IA32_EMULATION=y
# NVIDIA GPU passthrough: DMI (system identification) and PAT (write-combined
# BAR mappings for the GPU's framebuffer aperture).
CONFIG_DMI=y
CONFIG_X86_PAT=y
# Nested virtualization: /dev/kvm in the guest (CI runners, emulators,
# Firecracker/QEMU inside a sandbox) on hosts with nested KVM. ch_defconfig
# enables these today; listing them makes the build fail if they ever drop.
# The node boots guests with kvm.enable_virt_at_load=0 so VMX/SVM is on only
# while the guest runs VMs (snapshots are refused while it is).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
