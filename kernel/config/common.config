CONFIG_NF_NAT=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y
CONFIG_NETFILTER_SYNPROXY=y

# --- netfilter: nf_tables (nft, iptables-nft) -------------------------------------
