# vmon guest kernel: options layered on top of cloud-hypervisor's
# `ch_defconfig` (both arches). Everything is built in: module support is on
# only so GPU sandboxes can load the NVIDIA driver bundle's out-of-tree
# modules (see "loadable modules" below), and build.sh turns every `=m` that
# olddefconfig would produce back into `=y`, so guests never need
# /lib/modules or modprobe.
#
# `kernel/build.sh` fails if any line here does not survive `olddefconfig`
# with exactly this value, so every option is a hard requirement. Grouped by
# the guest feature that needs it; see kernel/README.md.

# --- identification / introspection -------------------------------------
CONFIG_LOCALVERSION="-vmon"
# /proc/config.gz: lets moby's check-config.sh and users inspect the config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- loadable modules (out-of-tree GPU drivers only) ----------------------
# The kernel itself has no modules. GPU sandboxes finit_module() nvidia.ko and
# nvidia-uvm.ko from the GPU driver bundle (kernel/nvidia.sh), which builds
# them against this exact tree; the kernel release (vermagic) must match.
# No module signing and no symbol CRCs: the bundle is built from the same
# tree and shipped next to the kernel, so neither adds safety.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# No usermode modprobe: request_module() (filesystem, netfilter and crypto
# autoloading) fails at once instead of spawning /sbin/modprobe in the guest.
CONFIG_MODPROBE_PATH=""
# No BTF for out-of-tree modules (pahole at bundle build time, no users).
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# --- NVIDIA GPU passthrough (nvidia.ko, nvidia-uvm.ko) -----------------------
# The whole GPU is a VFIO-passthrough PCI function. The open kernel modules
# need MSI/MSI-X, request_firmware() for the GSP firmware (loaded from the
# bundle via firmware_class.path), and MMU notifiers (UVM). Arch extras are in
# the arch fragments.
CONFIG_PCI_MSI=y
CONFIG_FW_LOADER=y
CONFIG_MMU_NOTIFIER=y
# dma-buf: nvidia-uvm links against it unconditionally. DMA_SHARED_BUFFER has
# no prompt; SYNC_FILE is the smallest option that selects it.
CONFIG_SYNC_FILE=y
CONFIG_DMA_SHARED_BUFFER=y

# --- ch_defconfig test/debug options that cost every sandbox -----------------
# The ktimer PPS client is a test source that fires every second; with
# PPS_DEBUG each event logs two dmesg lines, so idle sandboxes wake once a
# second and their kernel log fills with "pps pps0: PPS event" noise.
# CONFIG_PPS_CLIENT_KTIMER is not set
# CONFIG_PPS_DEBUG is not set

# --- process isolation (containers, sandboxes-in-sandboxes) ----------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# kcmp(2) + /proc/<pid>/map_files: used by systemd, CRIU, some debuggers.
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KEYS=y

# --- cgroup v2 controllers -------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=y
# Pressure stall information: systemd-oomd, container runtimes' memory.pressure.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
# io.weight / io.bfq.weight
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# --- BPF -------------------------------------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# BTF (CO-RE eBPF tools: bpftrace, libbpf tools, Cilium-style programs).
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y

# --- security modules ------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
# Landlock: unprivileged sandboxing used by agent CLIs (e.g. Codex on Linux).
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,bpf"

# --- networking core ---------------------------------------------------------
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_MULTICAST=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_MD5SIG=y
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
# SCTP sockets + `docker run -p 1234:1234/sctp`.
CONFIG_IP_SCTP=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
# Encrypted overlay networks (docker swarm) / IPsec.
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_GHASH=y

# --- virtual network devices -------------------------------------------------
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_WIREGUARD=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y

# --- traffic control ----------------------------------------------------------
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_U32=y
